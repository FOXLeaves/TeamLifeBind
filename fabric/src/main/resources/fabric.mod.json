{
  "schemaVersion": 1,
  "id": "teamlifebind",
  "version": "${version}",
  "name": "TeamLifeBind",
  "description": "Team survival PvP with shared lives, team beds and custom items.",
  "environment": "*",
  "mixins": ["teamlifebind.mixins.json"],
  "entrypoints": {
    "main": [
      "com.teamlifebind.fabric.TeamLifeBindFabric"
    ],
    "client": [
      "com.teamlifebind.fabric.TeamLifeBindFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "fabric-api": ">=${fabricApiVersion}",
    "minecraft": "~${minecraftVersion}",
    "java": ">=${javaVersion}"
  }
}
